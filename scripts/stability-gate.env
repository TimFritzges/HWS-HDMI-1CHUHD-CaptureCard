FAIL_MEMCOPY_MIN=1
FAIL_SOURCE_TRUTH_MISMATCH_MIN=1
FAIL_VIDEO_LONG_GAP_MIN=1
FAIL_VIDEO_SEQ_GAP_MIN=1
FAIL_VIDEO_MONOTONIC_MIN=1
